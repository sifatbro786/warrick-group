# Copy to .env.local for development. Never commit the real file.
# Production (Vercel / VPS): set the same keys in the host's env settings.

# ---- Site ---------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, sitemap, OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Database -----------------------------------------------------------
# Atlas: Network Access must allow 0.0.0.0/0 for Vercel (dynamic IPs).
MONGODB_URI=
# Only if you see "querySrv ECONNREFUSED": resolve the Atlas SRV record with
# these DNS servers instead of the system/ISP one.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- Auth (Phase 3) -----------------------------------------------------
# 32+ random bytes. Generate: openssl rand -base64 48
# Changing it logs every admin out.
JWT_SECRET=

# ---- Mail (Phase 2) -----------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
# true for 465, false for 587 (STARTTLS)
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME="Warrick Group"
# Receives an inquiry when its desk has no mailbox configured.
CONTACT_FALLBACK_INBOX=

# ---- Security -----------------------------------------------------------
# Salt for hashing visitor IPs (contact rate limit, inquiry records).
# Generate: openssl rand -base64 32
IP_HASH_SALT=

# ---- Uploads (Phase 4) --------------------------------------------------
# Folder for admin uploads, relative to the project root.
# Vercel's disk is read-only, so uploads only work on the VPS.
UPLOAD_DIR=uploads
# Max upload size in MB (Nginx client_max_body_size must be at least this).
UPLOAD_MAX_MB=8
# Uploading is switched off automatically on Vercel. Set true to switch it
# off anywhere else (images can still be added by pasting a URL).
# UPLOADS_DISABLED=true

# ---- Seed ---------------------------------------------------------------
# Used once by `npm run seed` to create the first super_admin if none exists.
# Change the password from the dashboard before going live.
SEED_SUPER_ADMIN_EMAIL=solaimanislamsifat@gmail.com
SEED_SUPER_ADMIN_PASSWORD=11111111
SEED_SUPER_ADMIN_NAME="Solaiman Islam Sifat"

# Optional: "true" tells all crawlers to stay out (staging). Vercel preview
# deployments are always disallowed automatically.
# ROBOTS_DISALLOW_ALL=true
